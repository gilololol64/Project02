<configuration>
	<property name="LOG_FILE" value="/TransactionLogs" />

	<appender name="OneFile" class="ch.qos.logback.core.rolling.RollingFileAppender">
		<file>${LOG_FILE}/1-Log.log</file>
		<rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
			<fileNamePattern>${LOG_FILE}/1-Log.%d{yyyy/MM}.%i.gz</fileNamePattern>
			<maxFileSize>25MB</maxFileSize>
			<maxHistory>90</maxHistory>
			<totalSizeCap>3GB</totalSizeCap>
		</rollingPolicy>
		<encoder>
			<pattern> %d{yyyy-MM-dd HH:mm:ss.SSS}  %-5level %logger{36} - %msg%n </pattern>
		</encoder>
	</appender>

