<configuration>
	<property name="LOG_FILE" value="logs/transactions" />

	<appender name="Transaction" class="ch.qos.logback.core.rolling.RollingFileAppender">
		<file>${LOG_FILE}/Log.log</file>
		<rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
			<fileNamePattern>${LOG_FILE}/Log.%d{yyyy/MM}.%i.gz</fileNamePattern>
			<maxFileSize>25MB</maxFileSize>
			<maxHistory>90</maxHistory>
			<totalSizeCap>3GB</totalSizeCap>
		</rollingPolicy>
		<encoder>
			<pattern> %d{yyyy-MM-dd HH:mm:ss.SSS}  %-5level %logger{36} - %msg%n </pattern>
		</encoder>
	</appender>

	<appender name="SQLErrors" class="ch.qos.logback.core.rolling.RollingFileAppender">
		<file>logs/SQL.log</file>
		<rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
			<fileNamePattern>logs/SQL.%d{yyyy/MM}.%i.gz</fileNamePattern>
			<maxFileSize>25MB</maxFileSize>
			<maxHistory>90</maxHistory>
			<totalSizeCap>3GB</totalSizeCap>
		</rollingPolicy>
		<encoder>
			<pattern> %d{yyyy-MM-dd HH:mm:ss.SSS} %method %-5level %logger{36} - %exception </pattern>
		</encoder>
	</appender>

	<appender name="General_Error" class="ch.qos.logback.core.rolling.RollingFileAppender">
		<file>logs/error.log</file>
		<rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
			<fileNamePattern>logs/error.%d{yyyy/MM}.%i.gz</fileNamePattern>
			<maxFileSize>25MB</maxFileSize>
			<maxHistory>90</maxHistory>
			<totalSizeCap>3GB</totalSizeCap>
		</rollingPolicy>
		<encoder>
			<pattern> %d{yyyy-MM-dd HH:mm:ss.SSS} %method %-5level %logger{36} - %exception </pattern>
		</encoder>
	</appender>

	<appender name="AccountAction" class="ch.qos.logback.core.rolling.RollingFileAppender">
		<file>logs/AccountAction.log</file>
		<rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
			<fileNamePattern>logs/AccountAction.%d{yyyy/MM}.%i.gz</fileNamePattern>
			<maxFileSize>25MB</maxFileSize>
			<maxHistory>90</maxHistory>
			<totalSizeCap>3GB</totalSizeCap>
		</rollingPolicy>
		<encoder>
			<pattern> %d{yyyy-MM-dd HH:mm:ss.SSS} %method %-5level %logger{36} - %exception - %msg%n </pattern>
		</encoder>
	</appender>

	<logger name="Bank.Transaction.logback" level="INFO" additivity="false">
		<appender-ref ref="Transaction"/>
			</logger>
	<logger name="Bank.logback.Error" level="ERROR" additivity="false">
		<appender-ref ref="General_Error" />
	</logger>
	<logger name="Bank.logback.SQLError" level="ERROR" additivity="false">
		<appender-ref ref="SQLErrors" />
	</logger>

	<root level="DEBUG">
		<appender-ref ref="AccountAction" />
	</root>

</configuration>